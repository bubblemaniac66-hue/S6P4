
@model S6P4.Models.DigimonListaViewModel
@using S6P4.Models
@{
    ViewBag.Title = "Digivice";
    Layout = "~/Views/Shared/_LayoutDigivice.cshtml";
    int delay = 0;
}

<aside class="lado">
    <div class="radar" aria-hidden="true"><i></i><i></i><i></i></div>

    <form class="mini-pantalla" action="@Url.Action("Index", "Digimon")" method="get">
        <p class="etq">ESCÁNER</p>
        <input class="campo" type="text" name="q" value="@Model.Q" placeholder="Nombre (ej. agumon)"
               aria-label="Buscar Digimon" autocomplete="off" />
        <select class="campo" name="nivel" aria-label="Nivel">
            <option value="">Todos los niveles</option>
            @foreach (var n in DigimonHelper.Niveles)
            {
                <option value="@n" @(string.Equals(Model.Nivel, n, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@DigimonHelper.NivelEs(n)</option>
            }
        </select>
        <button type="submit" class="btn cian">ESCANEAR</button>
    </form>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mini-pantalla" aria-label="Paginación">
            <p class="etq">PÁGINA</p>
            <p class="pag-estado">@Model.Pagina / @Model.TotalPaginas</p>
            <div class="pag-botones">
                <a class="btn @(Model.Pagina <= 1 ? "gris" : "")"
                   href="@Url.Action("Index", "Digimon", new { q = Model.Q, nivel = Model.Nivel, pagina = Model.Pagina - 1 })">◀</a>
                <a class="btn @(Model.Pagina >= Model.TotalPaginas ? "gris" : "")"
                   href="@Url.Action("Index", "Digimon", new { q = Model.Q, nivel = Model.Nivel, pagina = Model.Pagina + 1 })">▶</a>
            </div>
        </nav>
    }

    <div class="mandos" aria-hidden="true">
        <div class="dial"></div>
        <div class="pulsadores"><i></i><i></i><i></i><i></i></div>
    </div>
</aside>

<section class="vidrio">
    <p class="etq">REGISTRO DIGITAL @(Model.Total > 0 ? "· " + Model.Total + " ENCONTRADOS" : "")</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alerta error">⚠ @Model.Error</div>
    }
    else if (!Model.Digimon.Any())
    {
        <div class="vacio">No hay resultados para esa búsqueda.</div>
    }

    <div class="grid">
        @foreach (var d in Model.Digimon)
        {
            <a class="card" href="@Url.Action("Detalle", "Digimon", new { id = d.Id })" style="animation-delay:@(delay)ms">
                <div class="arte">
                    <span class="num">#@d.Id.ToString("0000")</span>
                    <img src="@d.Image" alt="@d.Name" loading="lazy" />
                </div>
                <div class="info"><h2 class="nombre">@d.Name</h2></div>
            </a>
            delay += 40;
        }
    </div>
</section>

